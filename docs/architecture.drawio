<mxfile host="app.diagrams.net"><diagram id="p1" name="Controlled from a laptop"><mxGraphModel adaptiveColors="auto" dx="1500" dy="900" grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1client" value="Laptop: the hub&#x27;s web page in a browser&lt;br&gt;hub/templates/app.html + hub/static/app.js" style="swimlane;startSize=44;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;rounded=1;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="340" height="516" as="geometry"/></mxCell><mxCell id="p1hub" value="Hub: python -m hub (Flask)&lt;br&gt;on a computer in the lab, port 8000" style="swimlane;startSize=44;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;rounded=1;" vertex="1" parent="1"><mxGeometry x="560" y="40" width="340" height="516" as="geometry"/></mxCell><mxCell id="p1robot" value="Robot: Raspberry Pi on a MasterPi chassis&lt;br&gt;one of up to 4, each with its own link" style="swimlane;startSize=44;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;rounded=1;" vertex="1" parent="1"><mxGeometry x="1100" y="40" width="340" height="516" as="geometry"/></mxCell><mxCell id="p1c0" value="&lt;b&gt;Sign in&lt;/b&gt;&lt;br&gt;A form on the page → POST /login. The hub sets a login cookie" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=12;" vertex="1" parent="p1client"><mxGeometry x="16" y="56" width="308" height="64" as="geometry"/></mxCell><mxCell id="p1c1" value="&lt;b&gt;Robot list&lt;/b&gt;&lt;br&gt;GET /api/robots every second" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=12;" vertex="1" parent="p1client"><mxGeometry x="16" y="132" width="308" height="64" as="geometry"/></mxCell><mxCell id="p1c2" value="&lt;b&gt;Camera&lt;/b&gt;&lt;br&gt;GET /api/robots/&amp;lt;name&amp;gt;/camera: one MJPEG stream that stays open, shown in an &amp;lt;img&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=12;" vertex="1" parent="p1client"><mxGeometry x="16" y="208" width="308" height="64" as="geometry"/></mxCell><mxCell id="p1c3" value="&lt;b&gt;Drive&lt;/b&gt;&lt;br&gt;Hold W A S D Q E or the on-screen buttons → POST …/drive about 10 times a second" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=12;" vertex="1" parent="p1client"><mxGeometry x="16" y="284" width="308" height="64" as="geometry"/></mxCell><mxCell id="p1c4" value="&lt;b&gt;Arm, Stop, Ping&lt;/b&gt;&lt;br&gt;POST …/arm, …/stop, …/ping" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=12;" vertex="1" parent="p1client"><mxGeometry x="16" y="360" width="308" height="64" as="geometry"/></mxCell><mxCell id="p1c5" value="&lt;b&gt;Add, Update, Remove, Terminal&lt;/b&gt;&lt;br&gt;POST /api/robots, …/update, …/remove, …/exec" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=12;" vertex="1" parent="p1client"><mxGeometry x="16" y="436" width="308" height="64" as="geometry"/></mxCell><mxCell id="p1h0" value="&lt;b&gt;auth.py&lt;/b&gt;&lt;br&gt;Signs you in: login cookie, CSRF token, blocks password guessing" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=12;" vertex="1" parent="p1hub"><mxGeometry x="16" y="56" width="308" height="64" as="geometry"/></mxCell><mxCell id="p1h1" value="&lt;b&gt;api.py&lt;/b&gt;&lt;br&gt;The REST API under /api. Checks you are signed in, then does what was asked" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=12;" vertex="1" parent="p1hub"><mxGeometry x="16" y="132" width="308" height="64" as="geometry"/></mxCell><mxCell id="p1h2" value="&lt;b&gt;control.py&lt;/b&gt;&lt;br&gt;One person controls a robot at a time (15 s after their last command). At most 25 commands a second" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=12;" vertex="1" parent="p1hub"><mxGeometry x="16" y="208" width="308" height="64" as="geometry"/></mxCell><mxCell id="p1h3" value="&lt;b&gt;robots.py&lt;/b&gt;&lt;br&gt;Keeps each robot&amp;#x27;s live link, its last sensor readings and its newest camera picture" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=12;" vertex="1" parent="p1hub"><mxGeometry x="16" y="284" width="308" height="64" as="geometry"/></mxCell><mxCell id="p1h4" value="&lt;b&gt;deploy.py + jobs.py&lt;/b&gt;&lt;br&gt;Installs, updates and removes the robot program, and runs Terminal commands" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=12;" vertex="1" parent="p1hub"><mxGeometry x="16" y="360" width="308" height="64" as="geometry"/></mxCell><mxCell id="p1h5" value="&lt;b&gt;storage.py → data/&lt;/b&gt;&lt;br&gt;Logins, keys, robot tokens and the list of installed robots (never committed)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=12;" vertex="1" parent="p1hub"><mxGeometry x="16" y="436" width="308" height="64" as="geometry"/></mxCell><mxCell id="p1r0" value="&lt;b&gt;robot_movement.py&lt;/b&gt;&lt;br&gt;Wheels and arm. Stops the wheels if drive commands stop for 0.5 s, or the hub is silent for 3 s" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=12;" vertex="1" parent="p1robot"><mxGeometry x="16" y="56" width="308" height="64" as="geometry"/></mxCell><mxCell id="p1r1" value="&lt;b&gt;camera.py&lt;/b&gt;&lt;br&gt;Sends JPEG pictures to the hub, only while someone is watching" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=12;" vertex="1" parent="p1robot"><mxGeometry x="16" y="132" width="308" height="64" as="geometry"/></mxCell><mxCell id="p1r2" value="&lt;b&gt;sensors.py&lt;/b&gt;&lt;br&gt;Distance (ultrasonic) and gyro, sent in every heartbeat" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=12;" vertex="1" parent="p1robot"><mxGeometry x="16" y="208" width="308" height="64" as="geometry"/></mxCell><mxCell id="p1r3" value="&lt;b&gt;robot_agent.py (swarm-agent service)&lt;/b&gt;&lt;br&gt;Connects out to the hub with its token, then a heartbeat every second" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=12;" vertex="1" parent="p1robot"><mxGeometry x="16" y="284" width="308" height="64" as="geometry"/></mxCell><mxCell id="p1r4" value="&lt;b&gt;SSH (the robot&amp;#x27;s Linux)&lt;/b&gt;&lt;br&gt;How the hub gets in to install and for the Terminal" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=12;" vertex="1" parent="p1robot"><mxGeometry x="16" y="360" width="308" height="64" as="geometry"/></mxCell><mxCell id="p1e1" value="HTTP requests&lt;br&gt;login cookie + CSRF token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeWidth=2;labelBackgroundColor=default;" edge="1" source="p1c1" target="p1h1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1e2" value="WebSocket /robot&lt;br&gt;commands out,&lt;br&gt;readings and&lt;br&gt;pictures back" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeWidth=2;labelBackgroundColor=default;startArrow=classic;" edge="1" source="p1h3" target="p1r3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1e3" value="SSH" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeWidth=2;labelBackgroundColor=default;" edge="1" source="p1h4" target="p1r4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1steps" value="&lt;b&gt;Driving from a laptop, step by step&lt;/b&gt;&lt;br&gt;1. You hold W. The page sends POST /api/robots/Clanker/drive {forward: 0.4} about 10 times a second.&lt;br&gt;2. The hub checks your login cookie and CSRF token, then that nobody else is controlling Clanker.&lt;br&gt;3. The hub passes the command down Clanker&#x27;s WebSocket.&lt;br&gt;4. The robot turns its wheels. Let go of W and the commands stop, so the robot stops." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="860" height="120" as="geometry"/></mxCell><mxCell id="p1safety" value="&lt;b&gt;The same on a laptop and on a phone&lt;/b&gt;&lt;br&gt;• Neither ever talks to a robot directly. Everything goes through the hub.&lt;br&gt;• Stop and Stop all never need control. Anyone signed in can press them.&lt;br&gt;• The robot stops by itself if commands stop arriving, so a closed page, a dead phone or dropped Wi-Fi is safe.&lt;br&gt;• Only one person drives a robot at a time. Others can watch and press Stop." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="920" y="580" width="520" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="Controlled from the phone app"><mxGraphModel adaptiveColors="auto" dx="1500" dy="900" grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2client" value="Phone: the app in mobile/&lt;br&gt;React Native + Expo, same hub and same API" style="swimlane;startSize=44;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;rounded=1;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="340" height="516" as="geometry"/></mxCell><mxCell id="p2hub" value="Hub: python -m hub (Flask)&lt;br&gt;on a computer in the lab, port 8000" style="swimlane;startSize=44;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;rounded=1;" vertex="1" parent="1"><mxGeometry x="560" y="40" width="340" height="516" as="geometry"/></mxCell><mxCell id="p2robot" value="Robot: Raspberry Pi on a MasterPi chassis&lt;br&gt;one of up to 4, each with its own link" style="swimlane;startSize=44;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;rounded=1;" vertex="1" parent="1"><mxGeometry x="1100" y="40" width="340" height="516" as="geometry"/></mxCell><mxCell id="p2c0" value="&lt;b&gt;Sign in&lt;/b&gt;&lt;br&gt;Type the hub&amp;#x27;s address and your login → POST /auth/login (JSON). The phone keeps the login cookie" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p2client"><mxGeometry x="16" y="56" width="308" height="64" as="geometry"/></mxCell><mxCell id="p2c1" value="&lt;b&gt;Robot list&lt;/b&gt;&lt;br&gt;GET /api/robots every second" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=12;" vertex="1" parent="p2client"><mxGeometry x="16" y="132" width="308" height="64" as="geometry"/></mxCell><mxCell id="p2c2" value="&lt;b&gt;Camera&lt;/b&gt;&lt;br&gt;GET /api/robots/&amp;lt;name&amp;gt;/snapshot about 5 times a second: one JPEG picture per request" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p2client"><mxGeometry x="16" y="208" width="308" height="64" as="geometry"/></mxCell><mxCell id="p2c3" value="&lt;b&gt;Drive&lt;/b&gt;&lt;br&gt;Two thumb sticks (Move and Turn) → POST …/drive about 10 times a second" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p2client"><mxGeometry x="16" y="284" width="308" height="64" as="geometry"/></mxCell><mxCell id="p2c4" value="&lt;b&gt;Arm, Stop, Ping&lt;/b&gt;&lt;br&gt;POST …/arm, …/stop, …/ping" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=12;" vertex="1" parent="p2client"><mxGeometry x="16" y="360" width="308" height="64" as="geometry"/></mxCell><mxCell id="p2c5" value="&lt;b&gt;Add, Update, Remove, Terminal&lt;/b&gt;&lt;br&gt;POST /api/robots, …/update, …/remove, …/exec" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=12;" vertex="1" parent="p2client"><mxGeometry x="16" y="436" width="308" height="64" as="geometry"/></mxCell><mxCell id="p2h0" value="&lt;b&gt;auth.py&lt;/b&gt;&lt;br&gt;Signs you in: login cookie, CSRF token, blocks password guessing" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=12;" vertex="1" parent="p2hub"><mxGeometry x="16" y="56" width="308" height="64" as="geometry"/></mxCell><mxCell id="p2h1" value="&lt;b&gt;api.py&lt;/b&gt;&lt;br&gt;The REST API under /api. Checks you are signed in, then does what was asked" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=12;" vertex="1" parent="p2hub"><mxGeometry x="16" y="132" width="308" height="64" as="geometry"/></mxCell><mxCell id="p2h2" value="&lt;b&gt;control.py&lt;/b&gt;&lt;br&gt;One person controls a robot at a time (15 s after their last command). At most 25 commands a second" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=12;" vertex="1" parent="p2hub"><mxGeometry x="16" y="208" width="308" height="64" as="geometry"/></mxCell><mxCell id="p2h3" value="&lt;b&gt;robots.py&lt;/b&gt;&lt;br&gt;Keeps each robot&amp;#x27;s live link, its last sensor readings and its newest camera picture" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=12;" vertex="1" parent="p2hub"><mxGeometry x="16" y="284" width="308" height="64" as="geometry"/></mxCell><mxCell id="p2h4" value="&lt;b&gt;deploy.py + jobs.py&lt;/b&gt;&lt;br&gt;Installs, updates and removes the robot program, and runs Terminal commands" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=12;" vertex="1" parent="p2hub"><mxGeometry x="16" y="360" width="308" height="64" as="geometry"/></mxCell><mxCell id="p2h5" value="&lt;b&gt;storage.py → data/&lt;/b&gt;&lt;br&gt;Logins, keys, robot tokens and the list of installed robots (never committed)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=12;" vertex="1" parent="p2hub"><mxGeometry x="16" y="436" width="308" height="64" as="geometry"/></mxCell><mxCell id="p2r0" value="&lt;b&gt;robot_movement.py&lt;/b&gt;&lt;br&gt;Wheels and arm. Stops the wheels if drive commands stop for 0.5 s, or the hub is silent for 3 s" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=12;" vertex="1" parent="p2robot"><mxGeometry x="16" y="56" width="308" height="64" as="geometry"/></mxCell><mxCell id="p2r1" value="&lt;b&gt;camera.py&lt;/b&gt;&lt;br&gt;Sends JPEG pictures to the hub, only while someone is watching" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=12;" vertex="1" parent="p2robot"><mxGeometry x="16" y="132" width="308" height="64" as="geometry"/></mxCell><mxCell id="p2r2" value="&lt;b&gt;sensors.py&lt;/b&gt;&lt;br&gt;Distance (ultrasonic) and gyro, sent in every heartbeat" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=12;" vertex="1" parent="p2robot"><mxGeometry x="16" y="208" width="308" height="64" as="geometry"/></mxCell><mxCell id="p2r3" value="&lt;b&gt;robot_agent.py (swarm-agent service)&lt;/b&gt;&lt;br&gt;Connects out to the hub with its token, then a heartbeat every second" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=12;" vertex="1" parent="p2robot"><mxGeometry x="16" y="284" width="308" height="64" as="geometry"/></mxCell><mxCell id="p2r4" value="&lt;b&gt;SSH (the robot&amp;#x27;s Linux)&lt;/b&gt;&lt;br&gt;How the hub gets in to install and for the Terminal" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=12;" vertex="1" parent="p2robot"><mxGeometry x="16" y="360" width="308" height="64" as="geometry"/></mxCell><mxCell id="p2e1" value="HTTP requests&lt;br&gt;login cookie + CSRF token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeWidth=2;labelBackgroundColor=default;" edge="1" source="p2c1" target="p2h1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2e2" value="WebSocket /robot&lt;br&gt;commands out,&lt;br&gt;readings and&lt;br&gt;pictures back" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeWidth=2;labelBackgroundColor=default;startArrow=classic;" edge="1" source="p2h3" target="p2r3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2e3" value="SSH" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeWidth=2;labelBackgroundColor=default;" edge="1" source="p2h4" target="p2r4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2steps" value="&lt;b&gt;Driving from the phone, step by step&lt;/b&gt;&lt;br&gt;1. You push the Move stick. The app sends POST /api/robots/Clanker/drive {forward: 0.4} about 10 times a second.&lt;br&gt;2. The hub checks your login cookie and CSRF token, then that nobody else is controlling Clanker.&lt;br&gt;3. The hub passes the command down Clanker&#x27;s WebSocket.&lt;br&gt;4. The robot turns its wheels. Let go of the stick and the app sends Stop." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="860" height="120" as="geometry"/></mxCell><mxCell id="p2safety" value="&lt;b&gt;The same on a laptop and on a phone&lt;/b&gt;&lt;br&gt;• Neither ever talks to a robot directly. Everything goes through the hub.&lt;br&gt;• Stop and Stop all never need control. Anyone signed in can press them.&lt;br&gt;• The robot stops by itself if commands stop arriving, so a closed page, a dead phone or dropped Wi-Fi is safe.&lt;br&gt;• Only one person drives a robot at a time. Others can watch and press Stop." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="920" y="580" width="520" height="120" as="geometry"/></mxCell><mxCell id="p2legend" value="Yellow = works differently from the laptop" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="716" width="340" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
